{
  "name": "@alphasayshello/codex-rpc",
  "version": "0.5.0",
  "description": "Local Discord presence and lifetime analytics for Codex and ChatGPT Desktop",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "codex-rpc": "bin/codex-rpc.js"
  },
  "files": [
    "bin",
    "src",
    "web",
    "assets",
    "electron/*.cjs",
    "electron/package.json",
    "electron/package-lock.json",
    "scripts",
    "README.md",
    "SECURITY.md",
    "VERSIONING.md",
    "LICENSE",
    "docs",
    "config.example.json",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test",
    "assets": "node src/assets/generate-pet-gifs.js",
    "start": "node bin/codex-rpc.js serve",
    "build:sea": "node scripts/build-sea.js",
    "check": "node scripts/check.js",
    "verify:desktop": "npm --prefix electron run verify",
    "release:prepare": "node scripts/prepare-release.js",
    "prepublishOnly": "npm run check && npm test -- --test-concurrency=4",
    "verify:pets": "npm --prefix electron run verify:pets",
    "benchmark:dashboard": "npm --prefix electron run benchmark"
  },
  "keywords": [
    "codex",
    "discord",
    "rpc",
    "analytics",
    "chatgpt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alphasayshello/codex-rpc.git"
  },
  "homepage": "https://github.com/alphasayshello/codex-rpc#readme",
  "bugs": {
    "url": "https://github.com/alphasayshello/codex-rpc/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
